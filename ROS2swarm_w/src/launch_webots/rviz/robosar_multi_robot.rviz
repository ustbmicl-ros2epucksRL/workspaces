Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.45
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    # ========== Static Map ==========
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: "Static Map (sim_map)"
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sim_map
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sim_map_updates
      Use Timestamp: false
      Value: false

    # ========== SLAM Map (bridged from ROS1 via ros1_bridge) ==========
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: "SLAM Map"
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam_toolbox/map
      Use Timestamp: false
      Value: true

    # ========== Grid ==========
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true

    # ========== TF ==========
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    # ========== Robot 0: LaserScan (ROS2 native) ==========
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 252; 233; 79
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: "Robot 0: LaserScan"
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robosar_agent_bringup_node/agent_0/feedback/scan
      Use Fixed Frame: true
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 85; 255; 127
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: "Robot 1: LaserScan"
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robosar_agent_bringup_node/agent_1/feedback/scan
      Use Fixed Frame: true
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 85; 170; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: "Robot 2: LaserScan"
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robosar_agent_bringup_node/agent_2/feedback/scan
      Use Fixed Frame: true
      Value: true

    # ========== Robot 0: Global Plan (bridged from ROS1) ==========
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 149; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Robot 0: Global Plan"
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_0/move_base_node/GlobalPlanner/plan
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 0; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Robot 0: Local Plan"
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_0/move_base_node/DWAPlannerROS/local_plan
      Value: true

    # ========== Robot 1: Plans ==========
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 149; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Robot 1: Global Plan"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/move_base_node/GlobalPlanner/plan
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 0; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Robot 1: Local Plan"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/move_base_node/DWAPlannerROS/local_plan
      Value: true

    # ========== Robot 2: Plans ==========
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 149; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Robot 2: Global Plan"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_2/move_base_node/GlobalPlanner/plan
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 0; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Robot 2: Local Plan"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_2/move_base_node/DWAPlannerROS/local_plan
      Value: true

    # ========== Robot Footprints (bridged from ROS1) ==========
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 0; 0
      Enabled: true
      Name: "Robot 0: Footprint"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_0/move_base_node/global_costmap/footprint
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 170; 0; 255
      Enabled: true
      Name: "Robot 1: Footprint"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/move_base_node/global_costmap/footprint
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 0; 170; 255
      Enabled: true
      Name: "Robot 2: Footprint"
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_2/move_base_node/global_costmap/footprint
      Value: true

    # ========== Markers (bridged from ROS1) ==========
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: "Velocity Markers"
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lazy_traffic_controller/vel_markers
      Value: true

    # ROS1 publishes Marker (single); use Marker not MarkerArray
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: "Victim Markers"
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam_toolbox/victim_markers
      Value: true

    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: "Frontier Centroids"
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /frontier_filter/frontier_centroids
      Value: true

    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: "Task Graph (RRT)"
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /task_graph/shapes
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: "SLAM Pose Graph"
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam_toolbox/karto_graph_visualization
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: "Coverage Area"
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /task_graph/coverage_area
      Value: true

    # ========== Costmaps (disabled by default) ==========
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: "Robot 0: Global Costmap"
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_0/move_base_node/global_costmap/costmap
      Value: false

    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: "Robot 0: Local Costmap"
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_0/move_base_node/local_costmap/costmap
      Value: false

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Theta std deviation: 0.26
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5698
      Target Frame: <Fixed Frame>
      Yaw: 4.7122
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1920
  X: 0
  Y: 0
