WorldInfo {
  info [
    "Environment with two vertical walls"
  ]
  title "Obstacle Navigation Environment"
  basicTimeStep 20
}
Viewpoint {
  orientation -0.3259129066293485 0.6045847308938715 0.7268136490617071 1.2809214799066853
  position -0.6554786770823011 -0.9985859086887117 1.3412109473782257
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 3.5 3.5
  wallHeight 0.4
}

# ===== 左侧墙（底部与环境相接） =====
# 从下边界 (y = -1.75) 向上延伸，高度 2.3m（约为环境高度的 2/3）
# 位置：x = -0.5（左侧区域），中心 y = -0.6
# 墙的范围：y = [-1.75, 0.55]
DEF wall_left Solid {
  translation -0.6 -0.6 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.9
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.05 2.3 0.3
      }
    }
  ]
  name "wall_left"
  boundingObject Box {
    size 0.05 2.3 0.3
  }
}

# ===== 右侧墙（顶部与环境边界相接） =====
# 从上边界 (y = 1.75) 向下延伸，高度 2.3m（约为环境高度的 2/3）
# 位置：x = 0.5（右侧区域），中心 y = 0.6
# 墙的范围：y = [-0.55, 1.75]
DEF wall_right Solid {
  translation 0.6 0.6 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.9
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.05 2.3 0.3
      }
    }
  ]
  name "wall_right"
  boundingObject Box {
    size 0.05 2.3 0.3
  }
}

