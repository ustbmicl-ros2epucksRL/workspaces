# The deployment script derives the workspace parent from this checkout and
# normalizes it to an absolute path. Override only for another sibling layout.
# MASAR_WORKSPACE_ROOT=/absolute/path/to/workspaces
# MASAR_XAUTHORITY=/home/your-user/.Xauthority
MASAR_HOST_DISPLAY=:0
MASAR_ROS2_DOMAIN_ID=42
MASAR_ROS2_LOCALHOST_ONLY=0

# Optional deployment-script overrides.
# MASAR_RUNTIME_DIR=/absolute/path/to/masar-simulation-platform/.runtime
# MASAR_PLATFORM_SECRET_PATH=/absolute/path/to/.runtime/agent.secret
# MASAR_PLATFORM_FORCE_FRONTEND_BUILD=1
