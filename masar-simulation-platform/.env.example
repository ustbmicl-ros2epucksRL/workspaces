# All services bind to loopback by default. Override only for a deliberate
# reverse-proxy or remote-development setup.
MASAR_PLATFORM_EXTERNAL_HOST=127.0.0.1
MASAR_PLATFORM_EXTERNAL_PORT=18090
MASAR_PLATFORM_API_HOST=127.0.0.1
MASAR_PLATFORM_API_PORT=18100
MASAR_PLATFORM_ROS1_AGENT_HOST=127.0.0.1
MASAR_PLATFORM_ROS1_AGENT_PORT=18101
MASAR_PLATFORM_ROS2_AGENT_HOST=127.0.0.1
MASAR_PLATFORM_ROS2_AGENT_PORT=18102
MASAR_PLATFORM_ROS1_ROSBRIDGE_PORT=18111
MASAR_PLATFORM_ROS2_ROSBRIDGE_PORT=18112
MASAR_PLATFORM_ROS1_VIDEO_PORT=18121
MASAR_PLATFORM_ROS2_VIDEO_PORT=18122
MASAR_PLATFORM_ROS1_NOVNC_PORT=18131
MASAR_PLATFORM_ROS2_NOVNC_PORT=18132
MASAR_PLATFORM_WEBOTS_STREAM_PORT=18141
# Relative overrides resolve from the service working directory. In a source
# checkout, leaving this unset defaults to this project's runs/ directory.
MASAR_PLATFORM_DATA_DIR=./runs
MASAR_PLATFORM_SECRET_PATH=/run/masar-platform/agent.secret
MASAR_PLATFORM_EVENT_RETENTION_DAYS=30
MASAR_PLATFORM_EVENT_RETENTION_COUNT=10000
