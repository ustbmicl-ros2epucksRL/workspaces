{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masar.local/schemas/scenario-manifest-v1.json",
  "title": "MASAR scenario manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "module",
    "simulator",
    "runtime",
    "display_profile",
    "parameters",
    "steps",
    "stop_order",
    "data_profile",
    "artifact_profile",
    "minimum_free_bytes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
    "module": {"enum": ["swarm", "control", "exploration", "rescue"]},
    "simulator": {"enum": ["gazebo", "webots"]},
    "runtime": {"$ref": "#/$defs/runtime"},
    "display_profile": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/parameter"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "stop_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "data_profile": {"type": "string", "minLength": 1},
    "artifact_profile": {"type": "string", "minLength": 1},
    "minimum_free_bytes": {"const": 2147483648}
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ros1_master_uri", "ros2_domain_id"],
      "properties": {
        "ros1_master_uri": {
          "type": "string",
          "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]{1,5}/?$"
        },
        "ros2_domain_id": {"type": "integer", "minimum": 0, "maximum": 232}
      }
    },
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "default", "enum"],
          "properties": {
            "type": {"const": "string"},
            "default": {"type": "string"},
            "enum": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1,
              "uniqueItems": true
            },
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "default", "minimum", "maximum"],
          "properties": {
            "type": {"const": "integer"},
            "default": {"type": "integer"},
            "enum": {
              "type": "array",
              "items": {"type": "integer"},
              "minItems": 1,
              "uniqueItems": true
            },
            "minimum": {"type": "number"},
            "maximum": {"type": "number"},
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "default", "minimum", "maximum"],
          "properties": {
            "type": {"const": "number"},
            "default": {"type": "number"},
            "enum": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 1,
              "uniqueItems": true
            },
            "minimum": {"type": "number"},
            "maximum": {"type": "number"},
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "default"],
          "properties": {
            "type": {"const": "boolean"},
            "default": {"type": "boolean"},
            "enum": {
              "type": "array",
              "items": {"type": "boolean"},
              "minItems": 1,
              "uniqueItems": true
            },
            "description": {"type": "string"}
          }
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {"enum": ["ros1_topic", "ros2_topic", "tcp", "http", "file"]},
        "name": {"type": "string", "minLength": 1},
        "message_type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean", "default": true},
        "max_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30, "default": 1.0},
        "qos_profile": {
          "enum": ["unknown", "system_default", "sensor_data", "services_default", "parameters", "parameter_events", "action_status_default"],
          "default": "system_default"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["ros1_topic", "ros2_topic"]}}},
          "then": {"required": ["message_type"]},
          "else": {"not": {"required": ["message_type"]}}
        },
        {
          "if": {"properties": {"type": {"const": "ros2_topic"}}},
          "else": {"properties": {"qos_profile": {"const": "system_default"}}}
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/probe"}
        }
      }
    },
    "grace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sigint", "sigterm", "sigkill"],
      "properties": {
        "sigint": {"const": 10},
        "sigterm": {"const": 5},
        "sigkill": {"const": 5}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agent",
        "command_ref",
        "depends_on",
        "readiness",
        "start_timeout_seconds",
        "grace_seconds"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "agent": {"enum": ["ros1", "ros2"]},
        "command_ref": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "readiness": {"$ref": "#/$defs/readiness"},
        "start_timeout_seconds": {"type": "integer", "minimum": 1},
        "grace_seconds": {"$ref": "#/$defs/grace"}
      }
    }
  }
}
