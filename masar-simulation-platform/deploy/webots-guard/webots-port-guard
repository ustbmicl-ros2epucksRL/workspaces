#!/bin/sh
set -eu

port=${MASAR_WEBOTS_STREAM_PORT:-18141}
comment=masar-webots-loopback-only

case "$port" in
  ''|*[!0-9]*)
    echo "MASAR_WEBOTS_STREAM_PORT must be an integer" >&2
    exit 2
    ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo "MASAR_WEBOTS_STREAM_PORT must be between 1 and 65535" >&2
  exit 2
fi

check_ipv4() {
  iptables -w 5 -C INPUT ! -i lo -p tcp --dport "$port" \
    -m comment --comment "$comment" -j REJECT --reject-with tcp-reset >/dev/null 2>&1
}

check_ipv6() {
  ip6tables -w 5 -C INPUT ! -i lo -p tcp --dport "$port" \
    -m comment --comment "$comment" -j REJECT --reject-with tcp-reset >/dev/null 2>&1
}

delete_rules() {
  if check_ipv6; then
    ip6tables -w 5 -D INPUT ! -i lo -p tcp --dport "$port" \
      -m comment --comment "$comment" -j REJECT --reject-with tcp-reset
  fi
  if check_ipv4; then
    iptables -w 5 -D INPUT ! -i lo -p tcp --dport "$port" \
      -m comment --comment "$comment" -j REJECT --reject-with tcp-reset
  fi
}

if [ "${1:-}" = "--healthcheck" ]; then
  check_ipv4 && check_ipv6
  exit
fi

if ! check_ipv4; then
  iptables -w 5 -I INPUT 1 ! -i lo -p tcp --dport "$port" \
    -m comment --comment "$comment" -j REJECT --reject-with tcp-reset
fi
if ! check_ipv6; then
  if ! ip6tables -w 5 -I INPUT 1 ! -i lo -p tcp --dport "$port" \
    -m comment --comment "$comment" -j REJECT --reject-with tcp-reset; then
    delete_rules
    exit 1
  fi
fi

stopping=0
trap 'stopping=1' INT TERM HUP
trap delete_rules EXIT
while [ "$stopping" -eq 0 ]; do
  sleep 1 &
  wait "$!" || true
done
