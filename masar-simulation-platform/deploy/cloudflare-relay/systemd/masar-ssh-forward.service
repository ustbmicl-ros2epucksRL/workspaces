[Unit]
Description=MASAR loopback-only SSH forward
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -i %h/cloudflare-relay/.secrets/masar_tunnel_ed25519 -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile=%h/cloudflare-relay/.secrets/known_hosts -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:18090:127.0.0.1:18090 zjc@202.204.62.208
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
