#!/usr/bin/env bash
set -eo pipefail

source /opt/ros/noetic/setup.bash
set -u

case "${1:-}" in
  rosbridge)
    exec roslaunch rosbridge_server rosbridge_websocket.launch \
      address:=127.0.0.1 \
      port:=18111 \
      retry_startup_delay:=2 \
      websocket_null_origin:=false \
      topics_glob:="${MASAR_ROS1_TOPICS_GLOB:-'[*]'}" \
      services_glob:="[rosapi/topics,/rosapi/topics]" \
      params_glob:="[]"
    ;;
  tf2_web_republisher)
    exec rosrun tf2_web_republisher tf2_web_republisher
    ;;
  web_video_server)
    exec rosrun web_video_server web_video_server \
      _address:=127.0.0.1 \
      _port:=18121
    ;;
  *)
    echo "unknown ROS1 sidecar program: ${1:-<missing>}" >&2
    exit 64
    ;;
esac
