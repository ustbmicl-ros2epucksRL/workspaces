#!/usr/bin/env bash
set -eo pipefail

source /opt/ros/noetic/setup.bash
set -u

case "${1:-}" in
  rosbridge)
    exec rosrun rosbridge_server rosbridge_websocket \
      _address:=127.0.0.1 \
      _port:=18111 \
      _retry_startup_delay:=2 \
      _websocket_null_origin:=false \
      _topics_glob:="${MASAR_ROS1_TOPICS_GLOB:-'[*]'}" \
      _services_glob:="'[]'" \
      _params_glob:="'[]'"
    ;;
  tf2_web_republisher)
    exec rosrun tf2_web_republisher tf2_web_republisher
    ;;
  web_video_server)
    exec rosrun web_video_server web_video_server \
      _address:=127.0.0.1 \
      _port:=18121
    ;;
  *)
    echo "unknown ROS1 sidecar program: ${1:-<missing>}" >&2
    exit 64
    ;;
esac
