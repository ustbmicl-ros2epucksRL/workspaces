<launch>
  <arg name="tb_id" default="0"/>
  <arg name="tb_num" default="4"/>
  <arg name="formation_interval" default="0.8"/>
  <arg name="rotate_slots_by_goal_yaw" default="false"/>
  <arg name="goal_tolerance" default="0.18"/>
  <arg name="lookahead_distance" default="0.6"/>
  <arg name="control_rate" default="10.0"/>
  <arg name="max_linear_velocity" default="0.20"/>
  <arg name="max_angular_velocity" default="1.20"/>
  <arg name="linear_gain" default="0.45"/>
  <arg name="angular_gain" default="1.80"/>

  <node name="tb_$(arg tb_id)_manager_node" type="plan_manager_node" pkg="plan_manager" output="screen">
    <remap from="~cmd_vel" to="/tb_$(arg tb_id)/cmd_vel"/>
    <param name="plan_manager/tb_id" value="$(arg tb_id)"/>
    <param name="plan_manager/tb_num" value="$(arg tb_num)"/>
    <param name="plan_manager/formation_interval" value="$(arg formation_interval)"/>
    <param name="plan_manager/rotate_slots_by_goal_yaw" value="$(arg rotate_slots_by_goal_yaw)"/>
    <param name="plan_manager/goal_tolerance" value="$(arg goal_tolerance)"/>
    <param name="plan_manager/lookahead_distance" value="$(arg lookahead_distance)"/>
    <param name="plan_manager/control_rate" value="$(arg control_rate)"/>
    <param name="plan_manager/max_linear_velocity" value="$(arg max_linear_velocity)"/>
    <param name="plan_manager/max_angular_velocity" value="$(arg max_angular_velocity)"/>
    <param name="plan_manager/linear_gain" value="$(arg linear_gain)"/>
    <param name="plan_manager/angular_gain" value="$(arg angular_gain)"/>
  </node>
</launch>
