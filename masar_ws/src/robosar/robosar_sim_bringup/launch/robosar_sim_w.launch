<launch>
  <param name="/use_sim_time" value="true"/>
  
  <!--使用stage_ros仿真时静态地图配置使用stage_config，使用gazebo时使用gazebo_config-->
  <node name="map_server" pkg="map_server" type="map_server" args="$(find robosar_sim_bringup)/worlds/gazebo_config/maps/tepper.yaml" respawn="false" >
    <remap from="/map" to="/sim_map"/>
  </node>
  
  <node pkg="robosar_sim_bringup" type="AprilTagSim.py" name="generate_april_tags_node" output="screen" />

  <!--其中仿真器的启动、机器人模型的加载 在 ros2 容器侧-->

  <!-- 启动初期先用临时 identity map->agent_N/odom 解除控制链的 TF 死锁；
       一旦 slam_toolbox 发布非零校正，该节点会自动停止对应 TF。 -->
  <node pkg="robosar_sim_bringup" type="bootstrap_map_tf.py" name="bootstrap_map_tf" output="screen">
    <rosparam param="odom_frames">[agent_0/odom, agent_1/odom, agent_2/odom, agent_3/odom, agent_4/odom]</rosparam>
    <param name="publish_hz" value="10.0" />
  </node>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robosar_sim_bringup)/rviz/multi_robot.rviz">
  </node>
</launch>
