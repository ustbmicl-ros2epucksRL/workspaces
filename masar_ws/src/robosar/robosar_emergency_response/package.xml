<?xml version="1.0"?>
<package format="2">
  <name>robosar_emergency_response</name>
  <version>0.0.0</version>
  <description>RoboSAR emergency response group orchestration for DEFORM-based formation navigation.</description>
  <maintainer email="ros-workstation@todo.todo">ros-workstation</maintainer>
  <license>LGPLv2.1</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>gazebo_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>robosar_messages</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>robosar_messages</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>drone_detect</exec_depend>
  <exec_depend>plan_manager</exec_depend>
  <exec_depend>ot_process</exec_depend>
  <exec_depend>multi_turtlebot3_simulation</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>realsense2_description</exec_depend>
  <exec_depend>realsense_gazebo_plugin</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export/>
</package>
