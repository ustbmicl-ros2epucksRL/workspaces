<launch>
  <arg name="map_topic" default="/map"/>
  <arg name="navigation_config"
       default="$(find robosar_emergency_response)/config/formation_navigation.yaml"/>

  <!-- One response group, one center plan, one shared deformation state. -->
  <node pkg="plan_manager" type="formation_navigation_node"
        name="formation_navigation_node" output="screen" required="true">
    <rosparam file="$(arg navigation_config)" command="load"/>
    <param name="map_topic" value="$(arg map_topic)"/>
  </node>
</launch>
