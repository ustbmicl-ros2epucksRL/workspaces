<launch>
  <!-- 当前机器人编号，由上层启动文件分别传入 0 到 3。 -->
  <arg name="tb_id" default="0"/>
  <!-- 响应组机器人总数。 -->
  <arg name="tb_num" default="4"/>
  <!-- 初始编队类型；数值越大队形越宽，运行中可根据环境收缩。 -->
  <arg name="frm_type" default="3"/>
  <!-- 允许扩展到的最大编队类型。 -->
  <arg name="max_frm_type" default="3"/>
  <!-- 轨迹优化时纳入考虑的邻近队友数量。 -->
  <arg name="other_num_in_opti" default="2"/>
  <!-- 编队槽位间距，单位为米。 -->
  <arg name="formation_interval" default="0.8"/>
  <!-- 领航机器人编号。 -->
  <arg name="leader_id" default="0"/>
  <!-- 普通编队一致性中局部路径目标的权重。 -->
  <arg name="formation_consensus_local_goal_weight" default="1.0"/>
  <!-- 窄走廊中将队形朝向吸附到地图主轴，避免局部目标微偏导致整列斜插墙面。 -->
  <arg name="formation_corridor_yaw_snap_enabled" default="true"/>
  <arg name="formation_corridor_yaw_snap_tolerance" default="0.70"/>
  <!-- 队友过近时对局部目标施加轻量分离偏置的最小距离。 -->
  <arg name="formation_min_robot_clearance" default="0.4"/>
  <!-- 队友过近分离偏置增益。 -->
  <arg name="formation_min_robot_clearance_gain" default="1.0"/>
  <!-- consensus 把局部目标压到脚边但仍远离最终槽位时保留的最小路径进展距离。 -->
  <arg name="formation_min_local_goal_progress" default="0.30"/>
  <!-- 允许收缩到的最小队形类型。默认保持 DEFORM 原行为，可由 Tepper 大系统单独收紧。 -->
  <arg name="formation_min_type" default="1"/>
  <!-- 触发队形收缩所需的近障碍机器人比例。 -->
  <arg name="formation_reduce_robot_fraction" default="0.2"/>
  <!-- DEFORM 内部 ESDF 避障状态触发距离。 -->
  <arg name="avoid_obs_distance_threshold" default="0.15"/>
  <!-- 是否启用 DEFORM 超时重分配。 -->
  <arg name="timeout_reassignment_enabled" default="true"/>
  <!-- 是否启用在线槽位重分配；用于运行中按当前相对位置重新匹配机器人与槽位。 -->
  <arg name="slot_reassignment_enabled" default="true"/>
  <!-- 在线槽位重分配的检查/应用冷却时间，单位为秒，避免槽位频繁来回切换。 -->
  <arg name="slot_reassignment_cooldown" default="2.0"/>
  <!-- 触发在线槽位重分配所需的最小绝对代价收益，单位近似为平方米。 -->
  <arg name="slot_reassignment_min_cost_improvement" default="0.08"/>
  <!-- 触发在线槽位重分配所需的最小相对代价收益。 -->
  <arg name="slot_reassignment_min_cost_improvement_ratio" default="0.10"/>
  <!-- NMPC 在局部目标明显未到但输出近零速时是否切到纯跟踪兜底。 -->
  <arg name="controller_stall_fallback_enabled" default="true"/>
  <arg name="controller_stall_fallback_goal_distance" default="0.35"/>
  <arg name="controller_stall_fallback_linear_epsilon" default="0.015"/>
  <!-- 当前机器人用于构建局部障碍地图的深度图话题。 -->
  <arg name="depth_topic" default="/tb_$(arg tb_id)/camera/depth/image_filter"/>
  <!-- 四机器人初始与期望队形槽位配置文件。 -->
  <arg name="frm_shape_file" default="$(find robosar_emergency_response)/config/deform/frm_shape_response4.yaml"/>

  <!-- 启动每个机器人的深度障碍检测节点。 -->
  <include file="$(find drone_detect)/launch/drone_detect.launch">
    <!-- 障碍检测节点使用的机器人编号。 -->
    <arg name="my_id" value="$(arg tb_id)"/>
  </include>

  <node name="tb_$(arg tb_id)_manager_node" type="plan_manager_node" pkg="plan_manager" output="screen">
    <!-- 将编队规划器输出速度接入响应组速度融合节点。 -->
    <remap from="~cmd_vel" to="/tb_$(arg tb_id)/deform_cmd_vel"/>
    <!-- 当前机器人里程计输入。 -->
    <remap from="~grid_map/odom" to="/tb_$(arg tb_id)/odom"/>
    <!-- 搜索组机器人等动态障碍从 Gazebo 位姿注入到 DEFORM 局部地图。 -->
    <remap from="~grid_map/cloud" to="/response_group/dynamic_obstacle_cloud"/>
    <!-- 当前阶段不使用该位姿输入，保留占位映射。 -->
    <remap from="~grid_map/pose" to="/pose_unused"/>
    <!-- 当前机器人深度图输入。 -->
    <remap from="~grid_map/depth" to="$(arg depth_topic)"/>

    <!-- 沿全局路径向前选取局部目标的距离，单位为米。 -->
    <param name="plan_manager/forward_distance" value="1.3"/>
    <!-- 距离最终目标较近时切入直接接近目标的距离阈值，单位为米。 -->
    <param name="plan_manager/approach_goal_distance" value="2.0"/>
    <!-- 接近目标阶段继续使用槽位目标，避免多机器人挤到同一中心点。 -->
    <param name="plan_manager/approach_center_goal" value="false"/>
    <!-- 是否发布编队规划器内部的距离场避障状态；阶段0由激光安全层统一发布。 -->
    <param name="plan_manager/publish_esdf_avoid_state" value="false"/>
    <!-- 是否在检测到走廊时将局部目标轻微推向通道中心。 -->
    <param name="plan_manager/center_local_goal_in_corridor" value="true"/>
    <!-- 认为需要通道居中的最大通道宽度，单位为米。 -->
    <param name="plan_manager/corridor_centering_max_width" value="2.4"/>
    <!-- 单次通道居中允许修正局部目标的最大位移，单位为米。 -->
    <param name="plan_manager/corridor_centering_max_shift" value="0.5"/>
    <!-- 窄走廊中把队形 yaw 吸附到最近的 90 度轴线，保持队形沿走廊中线展开。 -->
    <param name="plan_manager/formation_corridor_yaw_snap_enabled" value="$(arg formation_corridor_yaw_snap_enabled)"/>
    <param name="plan_manager/formation_corridor_yaw_snap_max_width" value="2.4"/>
    <param name="plan_manager/formation_corridor_yaw_snap_tolerance" value="$(arg formation_corridor_yaw_snap_tolerance)"/>
    <!-- 普通编队一致性中局部路径目标的权重。 -->
    <param name="plan_manager/formation_consensus_local_goal_weight" value="$(arg formation_consensus_local_goal_weight)"/>
    <!-- 队友过近时只修正局部目标，不让激光安全层把队友当障碍。 -->
    <param name="plan_manager/formation_min_robot_clearance" value="$(arg formation_min_robot_clearance)"/>
    <param name="plan_manager/formation_min_robot_clearance_gain" value="$(arg formation_min_robot_clearance_gain)"/>
    <param name="plan_manager/formation_min_local_goal_progress" value="$(arg formation_min_local_goal_progress)"/>
    <param name="plan_manager/formation_min_type" value="$(arg formation_min_type)"/>
    <param name="plan_manager/formation_reduce_robot_fraction" value="$(arg formation_reduce_robot_fraction)"/>
    <param name="plan_manager/avoid_obs_distance_threshold" value="$(arg avoid_obs_distance_threshold)"/>
    <param name="plan_manager/timeout_reassignment_enabled" value="$(arg timeout_reassignment_enabled)"/>
    <!-- 近障碍或窄通道信号需要连续保持多久才触发队形收缩，单位为秒。 -->
    <param name="plan_manager/formation_reduce_hold_time" value="0.6"/>
    <!-- 清晰通道信号需要连续保持多久才允许队形扩展，单位为秒。 -->
    <param name="plan_manager/formation_expand_hold_time" value="6.0"/>
    <!-- 队形刚收缩后禁止立即扩展的冷却时间，单位为秒。 -->
    <param name="plan_manager/formation_expansion_cooldown" value="12.0"/>
    <!-- 超时重分配槽位的冷却时间，单位为秒。 -->
    <param name="plan_manager/reassignment_cooldown" value="5.0"/>
    <!-- 在线槽位重分配开关。 -->
    <param name="plan_manager/slot_reassignment_enabled" value="$(arg slot_reassignment_enabled)"/>
    <!-- 在线槽位重分配检查/应用冷却时间，单位为秒。 -->
    <param name="plan_manager/slot_reassignment_cooldown" value="$(arg slot_reassignment_cooldown)"/>
    <!-- 在线槽位重分配所需最小绝对代价收益。 -->
    <param name="plan_manager/slot_reassignment_min_cost_improvement" value="$(arg slot_reassignment_min_cost_improvement)"/>
    <!-- 在线槽位重分配所需最小相对代价收益。 -->
    <param name="plan_manager/slot_reassignment_min_cost_improvement_ratio" value="$(arg slot_reassignment_min_cost_improvement_ratio)"/>
    <!-- 编队规划器避障安全距离，单位为米。 -->
    <param name="plan_manager/obs_clearance" value="0.35"/>
    <!-- 路径优化器避障安全距离，单位为米。 -->
    <param name="path_optimizer/obs_clearance" value="0.35"/>
    <!-- 领航机器人编号。 -->
    <param name="plan_manager/leader_id" value="$(arg leader_id)"/>
    <!-- 编队槽位间距，单位为米。 -->
    <param name="plan_manager/formation_interval" value="$(arg formation_interval)"/>
    <!-- 当前机器人编号。 -->
    <param name="plan_manager/tb_id" value="$(arg tb_id)"/>
    <!-- 响应组机器人总数。 -->
    <param name="plan_manager/tb_num" value="$(arg tb_num)"/>
    <!-- 轨迹优化时纳入考虑的邻近队友数量。 -->
    <param name="plan_manager/other_num_in_opti" value="$(arg other_num_in_opti)"/>
    <!-- 初始编队类型。 -->
    <param name="plan_manager/frm_type" value="$(arg frm_type)"/>
    <!-- 最大编队类型。 -->
    <param name="plan_manager/max_frm_type" value="$(arg max_frm_type)"/>
    <!-- 运行时缩放数据输出文件路径，用于调试和分析。 -->
    <param name="plan_manager/scalability_data_dir" value="/tmp/robosar_deform_data_$(arg tb_num)_$(arg tb_id).txt"/>

    <!-- 槽位重分配服务使用的机器人总数。 -->
    <param name="ot_client/tb_num" value="$(arg tb_num)"/>
    <!-- 槽位重分配服务使用的当前机器人编号。 -->
    <param name="ot_client/tb_id" value="$(arg tb_id)"/>

    <!-- 轨迹优化器认为到达局部目标的距离阈值，单位为米。 -->
    <param name="optimization/goal_distance_thresh" value="0.15"/>
    <!-- 轨迹优化预测步数。 -->
    <param name="controller/T" value="40"/>
    <!-- 轨迹优化时间步长，单位为秒。 -->
    <param name="controller/dt" value="0.1"/>
    <!-- 控制器中队友间最小期望距离，单位为米。 -->
    <param name="controller/distance_other_tb_dist" value="0.4"/>
    <!-- 控制器使用的机器人总数。 -->
    <param name="controller/tb_num" value="$(arg tb_num)"/>
    <!-- 控制器纳入考虑的邻近队友数量。 -->
    <param name="controller/other_num_in_opti" value="$(arg other_num_in_opti)"/>
    <param name="controller/stall_fallback_enabled" value="$(arg controller_stall_fallback_enabled)"/>
    <param name="controller/stall_fallback_goal_distance" value="$(arg controller_stall_fallback_goal_distance)"/>
    <param name="controller/stall_fallback_linear_epsilon" value="$(arg controller_stall_fallback_linear_epsilon)"/>
    <!-- 里程计或深度图短暂丢失时允许等待的最长时间，单位为秒。 -->
    <param name="grid_map/odom_depth_timeout" value="8.0"/>

    <!-- 加载二维局部地图和感知过滤配置。 -->
    <rosparam file="$(find plan_env2d)/config/env.yaml" command="load"/>
    <!-- 加载采样规划器配置。 -->
    <rosparam file="$(find plan_rrt)/config/rrt_cfg.yaml" command="load"/>
    <!-- 加载四机器人队形槽位配置。 -->
    <rosparam file="$(arg frm_shape_file)" command="load"/>
  </node>

  <!-- 启动当前机器人的槽位重分配服务。 -->
  <node name="tb_$(arg tb_id)_ot_server" type="ot_srv.py" pkg="ot_process" output="screen" launch-prefix="python3">
    <!-- 槽位重分配服务使用的当前机器人编号。 -->
    <param name="ot_srv/tb_id" value="$(arg tb_id)"/>
  </node>
</launch>
