<launch>
  <!-- 当前机器人编号，由上层启动文件分别传入 0 到 3。 -->
  <arg name="tb_id" default="0"/>
  <!-- 响应组机器人总数。 -->
  <arg name="tb_num" default="4"/>
  <!-- 初始编队类型；数值越大队形越宽，运行中可根据环境收缩。 -->
  <arg name="frm_type" default="3"/>
  <!-- 允许扩展到的最大编队类型。 -->
  <arg name="max_frm_type" default="3"/>
  <!-- 轨迹优化时纳入考虑的邻近队友数量。 -->
  <arg name="other_num_in_opti" default="2"/>
  <!-- 编队槽位间距，单位为米。 -->
  <arg name="formation_interval" default="0.8"/>
  <!-- 领航机器人编号。 -->
  <arg name="leader_id" default="0"/>
  <!-- 当前机器人用于构建局部障碍地图的深度图话题。 -->
  <arg name="depth_topic" default="/tb_$(arg tb_id)/camera/depth/image_filter"/>
  <!-- 四机器人初始与期望队形槽位配置文件。 -->
  <arg name="frm_shape_file" default="$(find robosar_emergency_response)/config/deform/frm_shape_response4.yaml"/>

  <!-- 启动每个机器人的深度障碍检测节点。 -->
  <include file="$(find drone_detect)/launch/drone_detect.launch">
    <!-- 障碍检测节点使用的机器人编号。 -->
    <arg name="my_id" value="$(arg tb_id)"/>
  </include>

  <node name="tb_$(arg tb_id)_manager_node" type="plan_manager_node" pkg="plan_manager" output="screen">
    <!-- 将编队规划器输出速度接入响应组速度融合节点。 -->
    <remap from="~cmd_vel" to="/tb_$(arg tb_id)/deform_cmd_vel"/>
    <!-- 当前机器人里程计输入。 -->
    <remap from="~grid_map/odom" to="/tb_$(arg tb_id)/odom"/>
    <!-- 当前阶段不使用该位姿输入，保留占位映射。 -->
    <remap from="~grid_map/pose" to="/pose_unused"/>
    <!-- 当前机器人深度图输入。 -->
    <remap from="~grid_map/depth" to="$(arg depth_topic)"/>

    <!-- 沿全局路径向前选取局部目标的距离，单位为米。 -->
    <param name="plan_manager/forward_distance" value="1.3"/>
    <!-- 距离最终目标较近时切入直接接近目标的距离阈值，单位为米。 -->
    <param name="plan_manager/approach_goal_distance" value="2.0"/>
    <!-- 接近目标阶段是否以目标中心为所有机器人最终接近点。 -->
    <param name="plan_manager/approach_center_goal" value="true"/>
    <!-- 是否发布编队规划器内部的距离场避障状态；阶段0由激光安全层统一发布。 -->
    <param name="plan_manager/publish_esdf_avoid_state" value="false"/>
    <!-- 是否在检测到走廊时将局部目标轻微推向通道中心。 -->
    <param name="plan_manager/center_local_goal_in_corridor" value="true"/>
    <!-- 认为需要通道居中的最大通道宽度，单位为米。 -->
    <param name="plan_manager/corridor_centering_max_width" value="2.4"/>
    <!-- 单次通道居中允许修正局部目标的最大位移，单位为米。 -->
    <param name="plan_manager/corridor_centering_max_shift" value="0.5"/>
    <!-- 普通编队一致性中局部路径目标的权重。 -->
    <param name="plan_manager/formation_consensus_local_goal_weight" value="1.0"/>
    <!-- 单列且存在近障碍压力时局部路径目标的权重；越大越优先沿可通行路径走。 -->
    <param name="plan_manager/narrow_corridor_local_goal_weight" value="3.6"/>
    <!-- 近障碍或窄通道信号需要连续保持多久才触发队形收缩，单位为秒。 -->
    <param name="plan_manager/formation_reduce_hold_time" value="0.6"/>
    <!-- 清晰通道信号需要连续保持多久才允许队形扩展，单位为秒。 -->
    <param name="plan_manager/formation_expand_hold_time" value="1.5"/>
    <!-- 队形刚收缩后禁止立即扩展的冷却时间，单位为秒。 -->
    <param name="plan_manager/formation_expansion_cooldown" value="4.0"/>
    <!-- 超时重分配槽位的冷却时间，单位为秒。 -->
    <param name="plan_manager/reassignment_cooldown" value="5.0"/>
    <!-- 编队规划器避障安全距离，单位为米。 -->
    <param name="plan_manager/obs_clearance" value="0.35"/>
    <!-- 路径优化器避障安全距离，单位为米。 -->
    <param name="path_optimizer/obs_clearance" value="0.35"/>
    <!-- 领航机器人编号。 -->
    <param name="plan_manager/leader_id" value="$(arg leader_id)"/>
    <!-- 编队槽位间距，单位为米。 -->
    <param name="plan_manager/formation_interval" value="$(arg formation_interval)"/>
    <!-- 当前机器人编号。 -->
    <param name="plan_manager/tb_id" value="$(arg tb_id)"/>
    <!-- 响应组机器人总数。 -->
    <param name="plan_manager/tb_num" value="$(arg tb_num)"/>
    <!-- 轨迹优化时纳入考虑的邻近队友数量。 -->
    <param name="plan_manager/other_num_in_opti" value="$(arg other_num_in_opti)"/>
    <!-- 初始编队类型。 -->
    <param name="plan_manager/frm_type" value="$(arg frm_type)"/>
    <!-- 最大编队类型。 -->
    <param name="plan_manager/max_frm_type" value="$(arg max_frm_type)"/>
    <!-- 运行时缩放数据输出文件路径，用于调试和分析。 -->
    <param name="plan_manager/scalability_data_dir" value="/tmp/robosar_deform_data_$(arg tb_num)_$(arg tb_id).txt"/>

    <!-- 槽位重分配服务使用的机器人总数。 -->
    <param name="ot_client/tb_num" value="$(arg tb_num)"/>
    <!-- 槽位重分配服务使用的当前机器人编号。 -->
    <param name="ot_client/tb_id" value="$(arg tb_id)"/>

    <!-- 轨迹优化器认为到达局部目标的距离阈值，单位为米。 -->
    <param name="optimization/goal_distance_thresh" value="0.15"/>
    <!-- 轨迹优化预测步数。 -->
    <param name="controller/T" value="40"/>
    <!-- 轨迹优化时间步长，单位为秒。 -->
    <param name="controller/dt" value="0.1"/>
    <!-- 控制器中队友间最小期望距离，单位为米。 -->
    <param name="controller/distance_other_tb_dist" value="0.4"/>
    <!-- 控制器使用的机器人总数。 -->
    <param name="controller/tb_num" value="$(arg tb_num)"/>
    <!-- 控制器纳入考虑的邻近队友数量。 -->
    <param name="controller/other_num_in_opti" value="$(arg other_num_in_opti)"/>
    <!-- 里程计或深度图短暂丢失时允许等待的最长时间，单位为秒。 -->
    <param name="grid_map/odom_depth_timeout" value="8.0"/>

    <!-- 加载二维局部地图和感知过滤配置。 -->
    <rosparam file="$(find plan_env2d)/config/env.yaml" command="load"/>
    <!-- 加载采样规划器配置。 -->
    <rosparam file="$(find plan_rrt)/config/rrt_cfg.yaml" command="load"/>
    <!-- 加载四机器人队形槽位配置。 -->
    <rosparam file="$(arg frm_shape_file)" command="load"/>
  </node>

  <!-- 启动当前机器人的槽位重分配服务。 -->
  <node name="tb_$(arg tb_id)_ot_server" type="ot_srv.py" pkg="ot_process" output="screen" launch-prefix="python3">
    <!-- 槽位重分配服务使用的当前机器人编号。 -->
    <param name="ot_srv/tb_id" value="$(arg tb_id)"/>
  </node>
</launch>
