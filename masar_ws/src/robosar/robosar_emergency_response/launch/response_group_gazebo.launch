<launch>
  <arg name="start_gazebo" default="true"/>
  <arg name="gz_gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="model" default="burger"/>
  <arg name="world_name" default="$(find robosar_emergency_response)/worlds/deform_navigation_demo.world"/>
  <arg name="tb_0_x" default="4.2"/>
  <arg name="tb_0_y" default="-4.6"/>
  <arg name="tb_0_yaw" default="1.5708"/>
  <arg name="tb_1_x" default="4.8"/>
  <arg name="tb_1_y" default="-4.6"/>
  <arg name="tb_1_yaw" default="1.5708"/>
  <arg name="tb_2_x" default="4.2"/>
  <arg name="tb_2_y" default="-5.2"/>
  <arg name="tb_2_yaw" default="1.5708"/>
  <arg name="tb_3_x" default="4.8"/>
  <arg name="tb_3_y" default="-5.2"/>
  <arg name="tb_3_yaw" default="1.5708"/>

  <include if="$(arg start_gazebo)" file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gz_gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <node if="$(arg rviz)" name="response_group_rviz" pkg="rviz" type="rviz"
        args="-d $(find multi_turtlebot3_simulation)/launch/multi_robot.rviz"/>

  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_0"/>
    <arg name="robot_x_pos" value="$(arg tb_0_x)"/>
    <arg name="robot_y_pos" value="$(arg tb_0_y)"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="$(arg tb_0_yaw)"/>
  </include>

  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_1"/>
    <arg name="robot_x_pos" value="$(arg tb_1_x)"/>
    <arg name="robot_y_pos" value="$(arg tb_1_y)"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="$(arg tb_1_yaw)"/>
  </include>

  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_2"/>
    <arg name="robot_x_pos" value="$(arg tb_2_x)"/>
    <arg name="robot_y_pos" value="$(arg tb_2_y)"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="$(arg tb_2_yaw)"/>
  </include>

  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_3"/>
    <arg name="robot_x_pos" value="$(arg tb_3_x)"/>
    <arg name="robot_y_pos" value="$(arg tb_3_y)"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="$(arg tb_3_yaw)"/>
  </include>
</launch>
