<sdf version='1.7'>
  <world name='roundflocking_controller_demo'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.82 0.82 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.25 0.15 -0.95</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material>
            <ambient>0.48 0.48 0.46 1</ambient>
            <diffuse>0.48 0.48 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='robosar_fire_1'>
      <static>1</static>
      <pose>0 0 0.18 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.18</radius><length>0.36</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.18</radius><length>0.36</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.20 0.04 1</ambient>
            <diffuse>1.0 0.20 0.04 1</diffuse>
            <emissive>0.28 0.04 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name='target_ring'>
      <static>1</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><cylinder><radius>1.05</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.04 0.40 1.0 0.35</ambient>
            <diffuse>0.04 0.40 1.0 0.35</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
