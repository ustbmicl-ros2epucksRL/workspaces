<sdf version='1.7'>
  <world name='transport_controller_demo'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.82 0.82 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.25 0.15 -0.95</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material>
            <ambient>0.48 0.48 0.46 1</ambient>
            <diffuse>0.48 0.48 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='robosar_target_zone_1'>
      <static>1</static>
      <pose>1.25 0 0.0125 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><cylinder><radius>0.45</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.82 0.24 1</ambient>
            <diffuse>0.05 0.82 0.24 1</diffuse>
            <emissive>0.0 0.14 0.02 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name='robosar_transport_box_1'>
      <static>0</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name='link'>
        <!-- Damped high-inertia box: remains pushable while low TB3 contact force no longer pitches it upward. -->
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.5</ixx>
            <iyy>0.5</iyy>
            <izz>0.5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.25</mu>
                <mu2>0.25</mu2>
                <fdir1>1 0 0</fdir1>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>50000</kp>
                <kd>0.2</kd>
                <min_depth>0.001</min_depth>
                <max_vel>0.1</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.86 0.66 0.20 1</ambient>
            <diffuse>0.86 0.66 0.20 1</diffuse>
            <specular>0.20 0.16 0.06 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.46 0.46 0.46 1</ambient>
      <background>0.73 0.75 0.77 1</background>
      <shadows>1</shadows>
    </scene>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -5.0 7.2 0 0.96 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
